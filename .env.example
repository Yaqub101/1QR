# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://convocation_user:convocation_password@db:5432/convocation_db

# Registration late cutoff time (ISO-8601 or HH:MM)
LATE_CUTOFF=2026-10-15T11:00:00+05:30

# Human-readable event title
EVENT_NAME=Annual Convocation 2026

# Optional application logging configuration
LOG_DIR=logs
LOG_LEVEL=INFO

# Sign-in sessions, sized for a multi-hour event day.
# Idle timeout in minutes (any activity renews it) and absolute lifetime in hours.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# Set to true only where the site is served over HTTPS.
COOKIE_SECURE=false

# First-time Admin and Deputy accounts are created with `python -m backend.seed`.
# Do NOT put credentials in this file or in .env. Supply them for that one command
# (or answer its prompts):
#   SEED_ADMIN_USERNAME, SEED_ADMIN_PASSWORD, SEED_DEPUTY_USERNAME, SEED_DEPUTY_PASSWORD

# Clock for the times operators read on screen ("ALREADY REGISTERED — 11:21 AM"): minutes from UTC.
# 330 = India (IST). A fixed offset works offline with no timezone database.
EVENT_UTC_OFFSET_MINUTES=330

# --- Student photo storage (backend/photo_storage.py).
# local (default): photo files in photos/ at the project root (/app/photos in Docker), or in
#   PHOTO_STORAGE_DIR if set. An explicitly set PHOTO_STORAGE_DIR must already exist: it is never
#   created, so an unmounted volume stops the server instead of silently losing photos.
# cloudinary: private ("authenticated") Cloudinary images. Use this on Render, whose disk is wiped on
#   every deploy. All three CLOUDINARY_ credentials are then required, or the server will not start.
#   Put the real values in Render's Environment settings as secrets -- never in this file or in Git.
PHOTO_STORAGE=local
# PHOTO_STORAGE_DIR=/app/photos
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=convocation/student-photos

# --- Backups (Phase 17). BACKUP_DIR should be on a SECOND device.
# BACKUP_DIR=/backups
BACKUP_INTERVAL_SECONDS=300
BACKUP_KEEP=24
