# Mode: "venue" or "central"
MODE=venue

# Venue ID: "college", "stadium", or "hall" (Required if MODE=venue, ignored if MODE=central)
VENUE_ID=college

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://convocation_user:convocation_password@db:5432/convocation_db

# Central cloud server URL (used by venue servers for outbox sync)
CENTRAL_URL=https://central.example.edu

# Per-venue authentication key for central sync
VENUE_API_KEY=placeholder_venue_api_key_replace_with_secret

# Registration late cutoff time (ISO-8601 or HH:MM)
LATE_CUTOFF=2026-10-15T11:00:00+05:30

# Human-readable event title
EVENT_NAME=Annual Convocation 2026

# Optional application logging configuration
LOG_DIR=logs
LOG_LEVEL=INFO

# Sign-in sessions, sized for a multi-hour event day.
# Idle timeout in minutes (any activity renews it) and absolute lifetime in hours.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# Set to true only where the site is served over HTTPS (central). Venue LANs use plain HTTP.
COOKIE_SECURE=false

# First-time Admin and Deputy accounts are created with `python -m backend.seed`.
# Do NOT put credentials in this file or in .env. Supply them for that one command
# (or answer its prompts):
#   SEED_ADMIN_USERNAME, SEED_ADMIN_PASSWORD, SEED_DEPUTY_USERNAME, SEED_DEPUTY_PASSWORD

# Clock for the times operators read on screen ("ALREADY REGISTERED — 11:21 AM"): minutes from UTC.
# 330 = India (IST). A fixed offset works offline with no timezone database.
EVENT_UTC_OFFSET_MINUTES=330

# --- Sync (Phase 14). A venue needs CENTRAL_URL and VENUE_API_KEY (issued at central: python -m backend.sync.keys issue --venue <v>).
# The key is only ever sent over HTTPS unless SYNC_REQUIRE_TLS=false (closed test networks only).
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_SIZE=200
SYNC_REQUIRE_TLS=true
# CENTRAL_CA_FILE=/path/to/central-ca.pem      # only for a private CA / self-signed certificate
# How long a peer venue's data counts as fresh is a setting in the database (default 120 s), changed by the Admin.

# --- Backups (Phase 17). BACKUP_DIR should be on a SECOND device. Central: use BACKUP_INTERVAL_SECONDS=86400.
# BACKUP_DIR=/backups
BACKUP_INTERVAL_SECONDS=300
BACKUP_KEEP=24
