# Secrets and environment
.env
*.env

# Student data and generated output
photos/
exports/

# Real university export files (contain real students' PII: name, PRN, email, mobile, and on the
# raw file, far more than that). These must never be committed, wherever they happen to be dropped.
StudentConvocationDetailReport*.xls
StudentConvocationDetailReport*.xlsx
*.xls
*.xlsx
!tests/fixtures/**/*.xls
!tests/fixtures/**/*.xlsx

# Database dumps (SQL migration files are kept)
*.dump
*.sql
!**/migrations/**/*.sql
!**/alembic/**/*.sql

# Automatic HA backups (SYSTEM_SPEC 21): a full dump every 5 minutes, regenerated continuously.
# Runtime output, not source -- never meant to be version-controlled.
backups/

# Student photo archives dropped at the repo root during manual testing/import work.
*.zip

# Python
__pycache__/
.pytest_cache/
*.pyc
.venv/
logs/
*.db
*.egg-info/

outputs/
.pgdata_test/
